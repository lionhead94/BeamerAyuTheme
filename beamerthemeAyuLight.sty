\definecolor{ayuBg3}      {HTML}{CBD0D7}  % ui.fg over bg (0.4)
\definecolor{ayuBg4}      {HTML}{828E9F}  % muted grey (ui.fg)
\definecolor{ayuFg}       {HTML}{5C6166}  % main foreground (editor.fg)
